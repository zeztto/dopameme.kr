# PostgreSQL container settings.
# These values are consumed by the internal Docker PostgreSQL service.
POSTGRES_DB=dopameme
POSTGRES_USER=dopameme
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Prisma connection string used by the app, migration job, and seed job.
# In Docker Compose, use the PostgreSQL service name `postgres` as the host.
# If the password contains special characters, percent-encode it in DATABASE_URL.
# Example: `p@ss#word` becomes `p%40ss%23word`.
DATABASE_URL=postgresql://dopameme:replace-with-strong-postgres-password@postgres:5432/dopameme

# Auth.js/NextAuth settings.
# Generate AUTH_SECRET with: openssl rand -base64 32
# Production AUTH_URL and NEXTAUTH_URL are fixed to the canonical domain.
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=https://dopameme.kr
NEXTAUTH_URL=https://dopameme.kr

# Initial production seed account.
# The seed job creates or updates this admin user and inserts mock markets.
# SEED_ADMIN_PASSWORD must be at least 12 characters.
SEED_ADMIN_EMAIL=admin@dopameme.kr
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_ADMIN_NAME=dopameme-admin

# Google OAuth credentials.
# Configure the OAuth callback URL as https://dopameme.kr/api/auth/callback/google.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Solana devnet DPMM token settings.
# These are public token/RPC values. Do not add mint authority, keypair,
# seed phrase, or private key values to this app.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
DPMM_MINT_ADDRESS=6fQ3D623QNsskcsdwHvUNgutFp1ptbQWUAYSoLFZTeyc
DPMM_TOKEN_PROGRAM=token-2022
DPMM_DECIMALS=9
DPMM_TOKEN_NAME=Dopameme
DPMM_TOKEN_SYMBOL=DPMM
DPMM_WALLET_LINK_DOMAIN=dopameme.kr
DPMM_EXPLORER_URL=https://explorer.solana.com
DPMM_MIN_WITHDRAWAL_AMOUNT=1000
# Optional public treasury wallet address. Enables source-wallet validation for
# recorded withdrawal transaction signatures. Do not store private keys here.
DPMM_TREASURY_WALLET_ADDRESS=

# Next.js standalone server settings inside Docker.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
